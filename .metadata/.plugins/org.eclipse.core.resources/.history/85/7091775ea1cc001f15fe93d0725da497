    public static void save() throws IOException{
    	try {
    		String resourcePath = SCUIFeature.class.getClassLoader().getResource(PROPERTIES_FILE).getPath();
    		System.out.println("Resource path resolved to: " + resourcePath);
    		File projectDirFile = new File(resourcePath);
    		if (!projectDirFile.exists()) {
                System.err.println("Warning: The properties file does not exist at: " + projectDirFile.getAbsolutePath());
            } else if (!projectDirFile.canWrite()) {
                System.err.println("Error: The properties file is not writable at: " + projectDirFile.getAbsolutePath());
                throw new IOException("Cannot write to the properties file: " + projectDirFile.getAbsolutePath());
            }
    		try (FileOutputStream fileOutput = new FileOutputStream(projectDirFile)) {
                properties.store(fileOutput, "SCALE CONNECTOR - Project Directory Properties File");
                System.out.println("Properties successfully saved to: " + projectDirFile.getAbsolutePath());
            }
    	} catch (NullPointerException e) {
    	        System.err.println("Error: Could not resolve the properties file path. Ensure the file exists in the project directory.");
    	        throw new IOException("Failed to locate the properties file in the project resources.", e);
    	} catch (IOException e) {
    	        System.err.println("Error: Failed to save properties to file. Reason: " + e.getMessage());
    	        throw e;
    	}
    }

}
