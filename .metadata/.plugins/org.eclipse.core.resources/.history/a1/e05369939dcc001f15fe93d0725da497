package com.ingeint.scaleconnector.gui.feature;

import java.io.*;
import java.util.Enumeration;
import java.util.Properties;

public class SCUIFeature {

    private static Properties properties = new Properties();
    private static final String PROPERTIES_FILE = "features.properties";
    private static final String EXTERNAL_PROPERTIES_FILE = System.getProperty("user.home") + File.separator + PROPERTIES_FILE;
    public static void load() throws IOException {
    	System.out.println("Attempting to load features.properties from: " + SCUIFeature.class.getClassLoader().getResource("features.properties"));
        InputStream input = SCUIFeature.class.getClassLoader().getResourceAsStream(PROPERTIES_FILE);
        if (input != null) {
            properties.load(input);
            input.close();
            System.out.println("Loaded features.properties: properties");
        } else {
            throw new FileNotFoundException("Properties file not found in the classpath: " + PROPERTIES_FILE);
        }
    }

    public static String get(String key) {
        return properties.getProperty(key);
    }

    public static Enumeration<Object> getKeys() {
        return properties.keys();
    }

    public static void set(String key, String value) {
        properties.put(key, value);
    }

    public static void save() throws IOException {
        // Save the properties to the external file in the user's home directory
        File externalFile = new File(EXTERNAL_PROPERTIES_FILE);
        try (FileOutputStream fileOutput = new FileOutputStream(externalFile)) {
            properties.store(fileOutput, "SCALE CONNECTOR - External Properties File");
            System.out.println("Properties saved to: " + EXTERNAL_PROPERTIES_FILE);
        } catch (IOException e) {
            throw new IOException("Failed to save properties to external file: " + EXTERNAL_PROPERTIES_FILE, e);
        }
    }
}
