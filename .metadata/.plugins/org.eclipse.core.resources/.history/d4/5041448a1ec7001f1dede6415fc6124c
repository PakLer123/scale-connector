	private String getValue(String string) {
	    char sc = (char) startCharacter;
	    String patternString = String.format("\\%cWeight: ([0-9.]+)", sc);
	    Pattern pattern = Pattern.compile(patternString);
	    Matcher matcher = pattern.matcher(string);
	
	    HashMap<String, Integer> list = new HashMap<>();
	    String raw = "";
	    String value = "";
	    String stability = "";
	
	    while (matcher.find()) {
	        raw = matcher.group(0);
	        log.info("Matched raw string: " + raw);
	
	        if (stabilityValuePosition >= 0 && stabilityValuePosition < raw.length()) {
	            stability = raw.substring(stabilityValuePosition, stabilityValuePosition + 1);
	        } else {
	            log.warning("Stability position out of bounds.");
	            stability = "0"; // Default stability
	        }
	
	        try {
	            int start = Math.max(0, startCutPosition);
	            int end = Math.min(raw.length(), endCutPosition + 1);
	            value = raw.substring(start, end).replaceAll("[^0-9.]", "");
	            log.info("Extracted value before floating-point adjustment: " + value);
	
	            if (!value.isEmpty() && floatingPoint > 0) {
	                value = String.valueOf(Double.parseDouble(value) / Math.pow(10, floatingPoint));
	            }
	
	            value = stability + value;
	        } catch (Exception e) {
	            log.warning("Error extracting value: " + e.getMessage());
	            continue;
	        }
	
	        if (list.containsKey(value)) {
	            list.put(value, list.get(value) + 1);
	        } else {
	            list.put(value, 1);
	        }

	    }
	
	    String keyMax = "";
	    int max = 0;
	
	    for (Map.Entry<String, Integer> entry : list.entrySet()) {
	        log.info("Value: " + entry.getKey() + ", Frequency: " + entry.getValue());
	        if (entry.getValue() > max) {
	            max = entry.getValue();
	            keyMax = entry.getKey();
	        }
	    }
	
	    log.info("Most frequent value: " + keyMax);
	    return keyMax;
	}


	/**
	 * Read bytes from the serial port and return the value. This method uses
	 * the readings for select the value
	 * 
	 * @return Value
	 * @throws SerialPortException
	 *             If an error occurred when reading from the input stream
	 * @throws SerialPortTimeoutException
	 *             If timeout expires before connecting
	 */
	public synchronized String readValue() {
	    HashMap<String, Integer> frequencyMap = new HashMap<>();
	    log.info("Starting to collect readings...");

	    try {
	        for (int i = 0; i < readings; i++) {
	            String rawValue;
	            try {
	                rawValue = readString(); // Read raw string
	            } catch (Exception e) {
	                log.warning("Error reading value from port: " + e.getMessage());
	                continue;
	            }

	            log.info("Raw value read: " + rawValue);
	            String processedValue = getValue(rawValue);
	            log.info("Processed value: " + processedValue);

	            if (processedValue == null || processedValue.isEmpty()) {
	                log.warning("Processed value is empty. Skipping...");
	                continue;
	            }

	            if (frequencyMap.containsKey(processedValue)) {
	                frequencyMap.put(processedValue, frequencyMap.get(processedValue) + 1);
	            } else {
	                frequencyMap.put(processedValue, 1);
	            }
	        }

	        // Determine the most frequent value
	        String mostFrequentValue = "";
	        int maxFrequency = 0;

	        for (Map.Entry<String, Integer> entry : frequencyMap.entrySet()) {
	            log.info("Value: " + entry.getKey() + ", Frequency: " + entry.getValue());
	            if (entry.getValue() > maxFrequency) {
	                maxFrequency = entry.getValue();
	                mostFrequentValue = entry.getKey();
	            }
	        }

	        isStableValue = !mostFrequentValue.isEmpty() && mostFrequentValue.charAt(0) == stabilityValue;
	        return mostFrequentValue.isEmpty() ? "" : mostFrequentValue.substring(1);

	    } catch (Exception e) {
	        log.severe("Unexpected error in readValue: " + e.getMessage());
	        return "";
	    }
	}

	/**
	 * Read string from the serial port
	 * 
	 * @return String
	 * @throws SerialPortException
	 *             If an error occurred when reading from the input stream
	 * @throws SerialPortTimeoutException
	 *             If timeout expires before connecting
	 */
	public synchronized String readString() throws Exception {
		byte[] buffer = readBytes();
		return new String(buffer);
	}

	/**
	 * Read bytes from the serial port
	 * 
	 * @return Bytes
	 * @throws SerialPortTimeoutException
	 *             If an error occurred when reading from the input stream
	 * @throws SerialPortException
	 *             If timeout expires before connecting
	 */
	public synchronized byte[] readBytes() throws Exception {
		
	    SerialPort sp = this.port;
	    if(!sp.isOpen() && !sp.openPort()) {
	    	throw new Exception("Unable to open port: " + serialPort);
	    }
	    byte[] buffer = new byte[byteCount];
	    log.info("Serial Port: " + serialPort);
	    log.info("Baud Rate: " + baud);
	    log.info("Data Bits: " + dataBits);
	    log.info("Stop Bits: " + stopBits);
	    log.info("Parity: " + parity);
	    log.info("Timeout: " + timeout);
	    try {
	        sp.setBaudRate(baud);
	        sp.setNumDataBits(dataBits);
	        sp.setNumStopBits(stopBits);
	        sp.setParity(parity);
	        sp.setComPortTimeouts(SerialPort.TIMEOUT_READ_BLOCKING, timeout, timeout);

	        if (!sp.openPort()) {
	            throw new Exception("Unable to open port: " + serialPort);
	        }

	        log.info("Port opened successfully: " + serialPort);

	        int bytesRead = sp.readBytes(buffer, buffer.length);
	        if (bytesRead < 0) {
	            throw new Exception("No data read from port.");
	        }

	        log.info("Bytes Read: " + bytesRead);
	        log.info("Data: " + Arrays.toString(buffer));
	        return buffer;
	    } catch (Exception e) {
	        log.severe("Error during port read: " + e.getMessage());
	        e.printStackTrace();
	        throw e;
	    } finally {
	        if (sp.isOpen()) {
	            sp.closePort();
	            log.info("Port closed: " + serialPort);
	        }
	    }
	}
